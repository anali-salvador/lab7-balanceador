# Puerto HTTP de la app
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=lab7pass
DB_NAME=lab7

# Debe ser IDÉNTICO en todas las instancias detrás del balanceador
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# true solo si el balanceador sirve HTTPS (en el laboratorio el ALB va por HTTP)
COOKIE_SECURE=false

# Opcional: nombre visible de esta instancia (pie de página, /health, X-Served-By).
# Si se deja vacío se usa el hostname de la máquina.
SERVER_NAME=
